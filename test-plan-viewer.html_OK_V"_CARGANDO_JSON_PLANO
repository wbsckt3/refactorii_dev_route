<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Plan de Automatización ISTQB</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.7.0/styles/github-dark-dimmed.css">
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/highlight.js@11.7.0/lib/common.min.js"></script>
  <style>
    :root {
      --primary: #2c3e50;
      --secondary: #3498db;
      --accent: #e74c3c;
      --light: #ecf0f1;
      --dark: #2c3e50;
      --success: #2ecc71;
      --warning: #f39c12;
      --info: #17a2b8;
      --gray: #95a5a6;
      --bg-light: #f8f9fa;
      --bg-dark: #1a1d21;
      --card-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      color: #333;
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      min-height: 100vh;
      padding: 20px;
    }
    
    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: white;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
      overflow: hidden;
    }
    
    header {
      background: var(--primary);
      color: white;
      padding: 25px;
      text-align: center;
      position: relative;
    }
    
    .logo {
      font-size: 2.5rem;
      margin-bottom: 10px;
    }
    
    h1 {
      font-size: 2.2rem;
      margin-bottom: 10px;
    }
    
    .subtitle {
      font-size: 1.1rem;
      opacity: 0.9;
      margin-bottom: 15px;
    }
    
    .metadata {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 15px;
      margin-top: 20px;
      padding: 15px;
      background: rgba(0, 0, 0, 0.2);
      border-radius: 8px;
    }
    
    .metadata-item {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    
    .metadata-label {
      font-size: 0.8rem;
      opacity: 0.8;
      margin-bottom: 5px;
    }
    
    .metadata-value {
      font-weight: 600;
      font-size: 1rem;
    }
    
    .tabs {
      display: flex;
      background: var(--light);
      border-bottom: 2px solid #ddd;
      overflow-x: auto;
    }
    
    .tab {
      padding: 15px 25px;
      cursor: pointer;
      font-weight: 600;
      border-bottom: 3px solid transparent;
      transition: all 0.3s ease;
      white-space: nowrap;
    }
    
    .tab:hover {
      background: rgba(52, 152, 219, 0.1);
    }
    
    .tab.active {
      border-bottom: 3px solid var(--secondary);
      color: var(--secondary);
    }
    
    .tab-content {
      display: none;
      padding: 30px;
      min-height: 400px;
    }
    
    .tab-content.active {
      display: block;
      animation: fadeIn 0.5s ease;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .card {
      background: white;
      border-radius: 8px;
      box-shadow: var(--card-shadow);
      margin-bottom: 25px;
      overflow: hidden;
    }
    
    .card-header {
      background: var(--light);
      padding: 15px 20px;
      font-weight: 600;
      border-bottom: 1px solid #ddd;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .card-body {
      padding: 20px;
    }
    
    pre {
      background-color: #2d2d2d;
      color: #f8f8f2;
      padding: 1em;
      border-radius: 5px;
      overflow-x: auto;
      margin: 15px 0;
      font-size: 0.9rem;
    }
    
    code {
      font-family: 'Fira Code', 'Consolas', monospace;
      background-color: #e0e0e0;
      padding: 0.2em 0.4em;
      border-radius: 3px;
      color: #c7254e;
      font-size: 0.9em;
    }
    
    pre code {
      background-color: transparent;
      color: inherit;
      padding: 0;
    }
    
    .file-tree {
      background: #2d2d2d;
      color: #f8f8f2;
      padding: 15px;
      border-radius: 5px;
      font-family: 'Fira Code', monospace;
      font-size: 0.9rem;
      line-height: 1.6;
      margin: 15px 0;
    }
    
    .file-tree div {
      margin-left: 20px;
      position: relative;
    }
    
    .file-tree div:before {
      content: "├── ";
      position: absolute;
      left: -20px;
      color: #6a737d;
    }
    
    .file-tree div:last-child:before {
      content: "└── ";
    }
    
    .actions {
      display: flex;
      gap: 15px;
      margin-top: 30px;
      flex-wrap: wrap;
    }
    
    .btn {
      padding: 12px 20px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s ease;
      text-decoration: none;
      border: none;
    }
    
    .btn-primary {
      background: var(--secondary);
      color: white;
    }
    
    .btn-primary:hover {
      background: #2980b9;
      transform: translateY(-2px);
    }
    
    .btn-secondary {
      background: var(--light);
      color: var(--dark);
    }
    
    .btn-secondary:hover {
      background: #bdc3c7;
    }
    
    .badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      margin-left: 8px;
    }
    
    .badge-success {
      background: var(--success);
      color: white;
    }
    
    .badge-warning {
      background: var(--warning);
      color: white;
    }
    
    .badge-info {
      background: var(--info);
      color: white;
    }
    
    .progress-bar {
      height: 8px;
      background: #e0e0e0;
      border-radius: 4px;
      overflow: hidden;
      margin: 15px 0;
    }
    
    .progress {
      height: 100%;
      background: var(--success);
      border-radius: 4px;
      width: 65%;
    }
    
    footer {
      text-align: center;
      padding: 20px;
      background: var(--light);
      color: var(--dark);
      font-size: 0.9rem;
    }
    
    .loading {
      text-align: center;
      padding: 40px;
      font-size: 1.2rem;
      color: var(--gray);
    }
    
    .error {
      text-align: center;
      padding: 40px;
      color: var(--accent);
      font-size: 1.1rem;
    }
    
    @media (max-width: 768px) {
      .tabs {
        flex-direction: column;
      }
      
      .tab {
        border-bottom: 1px solid #ddd;
        border-left: 3px solid transparent;
      }
      
      .tab.active {
        border-left: 3px solid var(--secondary);
        border-bottom: 1px solid #ddd;
      }
      
      .metadata {
        flex-direction: column;
        gap: 10px;
      }
      
      .metadata-item {
        flex-direction: row;
        justify-content: space-between;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header id="header">
      <div class="logo">
        <i class="fas fa-robot"></i>
      </div>
      <h1>Plan de Automatización ISTQB</h1>
      <p class="subtitle">Cargando información...</p>
      
      <div class="metadata" id="metadata">
        <div class="loading">
          <i class="fas fa-spinner fa-spin"></i> Cargando datos...
        </div>
      </div>
    </header>
    
    <div class="tabs">
      <div class="tab active" data-tab="resumen"><i class="fas fa-home"></i> Resumen</div>
      <div class="tab" data-tab="setup"><i class="fas fa-cogs"></i> Setup Local</div>
      <div class="tab" data-tab="config"><i class="fas fa-sliders-h"></i> Configuración</div>
      <div class="tab" data-tab="ejecucion"><i class="fas fa-play-circle"></i> Ejecución</div>
      <div class="tab" data-tab="cicd"><i class="fas fa-code-branch"></i> CI/CD</div>
    </div>
    
    <div class="tab-content active" id="resumen">
      <div class="loading">
        <i class="fas fa-spinner fa-spin"></i> Cargando resumen...
      </div>
    </div>
    
    <div class="tab-content" id="setup">
      <div class="loading">
        <i class="fas fa-spinner fa-spin"></i> Cargando setup local...
      </div>
    </div>
    
    <div class="tab-content" id="config">
      <div class="loading">
        <i class="fas fa-spinner fa-spin"></i> Cargando configuración...
      </div>
    </div>
    
    <div class="tab-content" id="ejecucion">
      <div class="loading">
        <i class="fas fa-spinner fa-spin"></i> Cargando ejecución...
      </div>
    </div>
    
    <div class="tab-content" id="cicd">
      <div class="loading">
        <i class="fas fa-spinner fa-spin"></i> Cargando CI/CD...
      </div>
    </div>
    
    <footer>
      <p>Plan de Automatización ISTQB • <span id="current-date"></span></p>
      <p>© 2023 Equipo de Calidad y Automatización</p>
    </footer>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Establecer fecha actual
      document.getElementById('current-date').textContent = new Date().toLocaleDateString('es-ES');
      
      // Configuración de marked con highlight.js
      marked.setOptions({
        highlight: function (code, lang) {
          if (lang && hljs.getLanguage(lang)) {
            return hljs.highlight(code, { language: lang }).value;
          }
          return hljs.highlightAuto(code).value;
        },
        gfm: true,
        breaks: true
      });
      
      // Funcionalidad de pestañas
      const tabs = document.querySelectorAll('.tab');
      const tabContents = document.querySelectorAll('.tab-content');
      
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const tabId = tab.getAttribute('data-tab');
          
          // Desactivar todas las pestañas
          tabs.forEach(t => t.classList.remove('active'));
          tabContents.forEach(tc => tc.classList.remove('active'));
          
          // Activar la pestaña seleccionada
          tab.classList.add('active');
          document.getElementById(tabId).classList.add('active');
        });
      });
      
      // Cargar datos de la API
      loadAutomationPlan();
    });
    
    async function loadAutomationPlan() {
      const params = new URLSearchParams(window.location.search);
      const rutaId = params.get('rutaId');
      const userEmail = params.get('email');
      
      if (!rutaId || !userEmail) {
        showError('Faltan parámetros en la URL: se necesitan rutaId y email');
        return;
      }
      
      try {
        const response = await fetch(`https://www.refactorii.com/api/tenant/workflow/planeador_de_automatizacion_ISTQB/verifyExercisesInPath`, {
          method: "GET",
          headers: {
            'Content-Type': 'application/json',
            'x-user-email': userEmail.toLowerCase().trim(),
            'x-path-id': String(rutaId)
          }
        });
        
        if (!response.ok) {
          throw new Error(`Error HTTP ${response.status} al obtener ejercicios de la ruta ${rutaId}`);
        }
        
        const data = await response.json();
        const ruta = data?.ruta;
        
        if (ruta?.exercises) {
          renderAutomationPlan(ruta);
        } else {
          showError('No se encontraron ejercicios válidos en la respuesta');
        }
        
      } catch (error) {
        showError('Error al cargar el plan de automatización: ' + error.message);
      }
    }
    
    function renderAutomationPlan(planData) {
      // Actualizar header con metadatos
      document.querySelector('.subtitle').textContent = planData.objetivo || 'Plan de automatización de pruebas';
      
      // Actualizar metadata
      const metadataContainer = document.getElementById('metadata');
      metadataContainer.innerHTML = `
        <div class="metadata-item">
          <span class="metadata-label">Framework</span>
          <span class="metadata-value">${planData.framework || 'Cypress'}</span>
        </div>
        <div class="metadata-item">
          <span class="metadata-label">Prioridad</span>
          <span class="metadata-value">${planData.prioridad || 'Alta'}</span>
        </div>
        <div class="metadata-item">
          <span class="metadata-label">Ambiente</span>
          <span class="metadata-value">${planData.ambiente || 'Local'}</span>
        </div>
        <div class="metadata-item">
          <span class="metadata-label">Estado</span>
          <span class="metadata-value">${planData.progreso || 'En desarrollo'}</span>
        </div>
        <div class="metadata-item">
          <span class="metadata-label">Fecha</span>
          <span class="metadata-value">${planData.fechaEjecucion || new Date().toLocaleDateString('es-ES')}</span>
        </div>
      `;
      
      // Parsear el JSON de exercises que contiene el plan completo
      let planContent;
      try {
        planContent = JSON.parse(planData.exercises);
      } catch (e) {
        // Si no es JSON válido, tratar como markdown
        renderFallbackContent(planData.exercises);
        return;
      }
      
      // Renderizar cada sección del plan
      renderResumen(planContent.resumenEjecutivo);
      renderSetupLocal(planContent.setupLocal);
      renderConfiguracionPruebas(planContent.configuracionPruebas);
      renderEjecucionPruebas(planContent.ejecucionPruebas);
      renderCICD(planContent.integracionCI_CD);
      
      // Resaltar código después de renderizar
      setTimeout(() => {
        document.querySelectorAll('pre code').forEach((block) => {
          hljs.highlightElement(block);
        });
      }, 100);
    }
    
    function renderResumen(resumen) {
      const resumenContainer = document.getElementById('resumen');
      
      if (typeof resumen === 'string') {
        // Si es markdown, convertirlo
        resumenContainer.innerHTML = `
          <div class="card">
            <div class="card-header">
              <i class="fas fa-info-circle"></i> Resumen Ejecutivo
            </div>
            <div class="card-body">
              ${marked.parse(resumen)}
            </div>
          </div>
        `;
      } else if (typeof resumen === 'object') {
        // Si es objeto, renderizar según estructura
        resumenContainer.innerHTML = `
          <div class="card">
            <div class="card-header">
              <i class="fas fa-info-circle"></i> Resumen Ejecutivo
            </div>
            <div class="card-body">
              <p>${resumen.descripcion || 'Resumen del plan de automatización.'}</p>
              <h3>Objetivos principales</h3>
              <ul>
                ${resumen.objetivos ? resumen.objetivos.map(obj => `<li>${obj}</li>`).join('') : ''}
              </ul>
              <div class="progress-bar">
                <div class="progress" style="width: ${resumen.progreso || 65}%"></div>
              </div>
              <div style="text-align: center; font-size: 0.9rem;">Progreso general: ${resumen.progreso || 65}%</div>
            </div>
          </div>
        `;
      }
    }
    
    function renderSetupLocal(setupData) {
      const setupContainer = document.getElementById('setup');
      
      if (typeof setupData === 'string') {
        setupContainer.innerHTML = `
          <div class="card">
            <div class="card-header">
              <i class="fas fa-cogs"></i> Setup Local
            </div>
            <div class="card-body">
              ${marked.parse(setupData)}
            </div>
          </div>
        `;
      } else if (typeof setupData === 'object') {
        setupContainer.innerHTML = `
          <div class="card">
            <div class="card-header">
              <i class="fas fa-folder-tree"></i> Estructura del Proyecto
            </div>
            <div class="card-body">
              <p>${setupData.explicacionEstructura || 'Estructura del proyecto de automatización.'}</p>
              ${setupData.arbolArchivos ? `<div class="file-tree">${setupData.arbolArchivos}</div>` : ''}
            </div>
          </div>
          
          <div class="card">
            <div class="card-header">
              <i class="fas fa-code"></i> Script de Configuración
            </div>
            <div class="card-body">
              ${setupData.scriptPowershell ? `
                <pre><code class="language-powershell">${setupData.scriptPowershell}</code></pre>
              ` : ''}
              
              ${setupData.packageJson ? `
                <h4>Package.json</h4>
                <pre><code class="language-json">${setupData.packageJson}</code></pre>
              ` : ''}
            </div>
          </div>
        `;
      }
    }
    
    function renderConfiguracionPruebas(configData) {
      const configContainer = document.getElementById('config');
      
      if (typeof configData === 'string') {
        configContainer.innerHTML = `
          <div class="card">
            <div class="card-header">
              <i class="fas fa-sliders-h"></i> Configuración de Pruebas
            </div>
            <div class="card-body">
              ${marked.parse(configData)}
            </div>
          </div>
        `;
      } else if (typeof configData === 'object') {
        configContainer.innerHTML = `
          <div class="card">
            <div class="card-header">
              <i class="fas fa-wrench"></i> Configuración del Backend
            </div>
            <div class="card-body">
              ${configData.configuracionBackend ? marked.parse(configData.configuracionBackend) : ''}
            </div>
          </div>
          
          <div class="card">
            <div class="card-header">
              <i class="fas fa-cog"></i> Configuración de Cypress
            </div>
            <div class="card-body">
              ${configData.configuracionCypress ? marked.parse(configData.configuracionCypress) : ''}
            </div>
          </div>
          
          <div class="card">
            <div class="card-header">
              <i class="fas fa-check-circle"></i> Verificación del Ambiente
            </div>
            <div class="card-body">
              ${configData.verificacionAmbiente ? marked.parse(configData.verificacionAmbiente) : ''}
            </div>
          </div>
        `;
      }
    }
    
    function renderEjecucionPruebas(ejecucionData) {
      const ejecucionContainer = document.getElementById('ejecucion');
      
      if (typeof ejecucionData === 'string') {
        ejecucionContainer.innerHTML = `
          <div class="card">
            <div class="card-header">
              <i class="fas fa-play-circle"></i> Ejecución de Pruebas
            </div>
            <div class="card-body">
              ${marked.parse(ejecucionData)}
            </div>
          </div>
        `;
      } else {
        ejecucionContainer.innerHTML = `
          <div class="card">
            <div class="card-header">
              <i class="fas fa-terminal"></i> Comandos de Ejecución
            </div>
            <div class="card-body">
              ${marked.parse(ejecucionData || 'Contenido de ejecución de pruebas')}
              
              <div class="actions">
                <button class="btn btn-primary">
                  <i class="fas fa-play"></i> Ejecutar Pruebas
                </button>
                <button class="btn btn-secondary">
                  <i class="fas fa-download"></i> Descargar Reporte
                </button>
              </div>
            </div>
          </div>
        `;
      }
    }
    
    function renderCICD(cicdData) {
      const cicdContainer = document.getElementById('cicd');
      
      if (typeof cicdData === 'string') {
        cicdContainer.innerHTML = `
          <div class="card">
            <div class="card-header">
              <i class="fas fa-code-branch"></i> Integración CI/CD
            </div>
            <div class="card-body">
              ${marked.parse(cicdData)}
            </div>
          </div>
        `;
      } else {
        cicdContainer.innerHTML = `
          <div class="card">
            <div class="card-header">
              <i class="fas fa-code-branch"></i> Integración CI/CD
            </div>
            <div class="card-body">
              ${marked.parse(cicdData || 'Configuración de integración continua.')}
            </div>
          </div>
        `;
      }
    }
    
    function renderFallbackContent(markdownContent) {
      // Si el contenido es solo markdown, renderizarlo en la pestaña de resumen
      document.getElementById('resumen').innerHTML = `
        <div class="card">
          <div class="card-header">
            <i class="fas fa-file-alt"></i> Plan de Automatización
          </div>
          <div class="card-body">
            ${marked.parse(markdownContent)}
          </div>
        </div>
      `;
      
      // Ocultar las otras pestañas
      document.querySelectorAll('.tab:not([data-tab="resumen"])').forEach(tab => {
        tab.style.display = 'none';
      });
    }
    
    function showError(message) {
      const header = document.getElementById('header');
      header.innerHTML = `
        <div class="error">
          <i class="fas fa-exclamation-triangle"></i>
          <h2>Error al cargar el plan</h2>
          <p>${message}</p>
        </div>
      `;
      
      document.querySelectorAll('.tab-content').forEach(container => {
        container.innerHTML = '';
      });
    }
  </script>
</body>
</html>
